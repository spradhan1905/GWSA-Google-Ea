# Local development can leave this blank when Vite proxies/same-origin routing is used.
# Azure Static Web Apps should set this to the Azure App Service backend URL.
VITE_API_BASE_URL=https://gwsa-backend-hdf7ajdhgyacf3a9.centralus-01.azurewebsites.net

# Required for Google Maps in the browser. Restrict this key by HTTP referrer in Google Cloud.
VITE_GOOGLE_MAPS_API_KEY=AIzaSyAN_z0st1Y9cFkd9DtOvl1zXe8jXGFWCCU

# ─── Microsoft Entra ID (Azure AD) — single sign-on ───────────────────────────
# Required to enable the Sign-in with Microsoft flow. Leave blank in local dev
# to run the app without auth.
#
# VITE_AZURE_TENANT_ID  — GWSA tenant directory ID (found in Entra ID overview).
# VITE_AZURE_CLIENT_ID  — Application (client) ID of the GWSA Geo-Analytics app
#                         registration.
# VITE_AZURE_API_SCOPE  — Full scope string for the backend API. Must match the
#                         "Expose an API" scope on the app registration.
VITE_AZURE_TENANT_ID=ac0e2845-197b-4147-9028-1262649ebff6
VITE_AZURE_CLIENT_ID=1ac1ba0b-bfdc-4532-aac4-b9e3c9891609
VITE_AZURE_API_SCOPE=api://1ac1ba0b-bfdc-4532-aac4-b9e3c9891609/user_impersonation
